# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# --- Ollama ---
OLLAMA_URL=http://localhost:11434/api/chat
MODEL=bielik-11b

# --- Dopasowanie po znaczeniu (opcjonalnie; wymaga: ollama pull bge-m3) ---
EMB_WLACZONE=0
EMB_PROG=0.65
EMB_MODEL=bge-m3

# --- Bot Telegram (tylko jeśli używasz bota) ---
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Ustawienia ogólne ---
CV_DEFAULT_JEZYK=pl
# CV_PYTHON=   (opcjonalnie: ścieżka do innego interpretera Pythona dla bota)
